---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import { getRelativeLocaleUrl } from 'astro:i18n';
import Sprite from '../components/Sprite.astro';
import { locales, type Locale } from '../i18n';
import { themeColor } from '../data/site';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Texte du lien d'évitement ; absent : pas de lien (page racine). */
  skipLabel?: string;
}

const { locale, title, description, skipLabel } = Astro.props;

// URL absolue si SITE_URL est défini à la compilation, relative sinon.
const toUrl = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path);
const alternates = locales.map((code) => ({
  code,
  href: toUrl(getRelativeLocaleUrl(code)),
}));
const rootUrl = toUrl(import.meta.env.BASE_URL);
const canonical = toUrl(getRelativeLocaleUrl(locale));
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content={themeColor} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {Astro.site && <link rel="canonical" href={canonical} />}
    {alternates.map(({ code, href }) => (
      <link rel="alternate" hreflang={code} href={href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={rootUrl} />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <slot name="head" />
  </head>
  <body>
    {skipLabel && (
      <a class="skip" href="#contenu">
        {skipLabel}
      </a>
    )}
    <Sprite />
    <slot />
  </body>
</html>
