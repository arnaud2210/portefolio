---
import ProjectContext from './ProjectContext.astro';
import ProjectTitle from './ProjectTitle.astro';
import TagList from './TagList.astro';
import { getDictionary, type Locale } from '../i18n';
import type { ShortProject } from '../data/projects';

interface Props {
  locale: Locale;
  project: ShortProject;
}

const { locale, project } = Astro.props;
const t = getDictionary(locale);
const texts = t.projects.others[project.id];
---

<article class="proj" id={`p-${project.id}`}>
  <ProjectTitle locale={locale} project={project} title={texts.title} />
  <p>{texts.text}</p>
  <TagList items={project.stack} label={t.projects.stackLabel} terms={t.terms} />
  <ProjectContext locale={locale} project={project} label={texts.context} />
</article>
